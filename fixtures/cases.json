{
  "description": "标准样例集：解析/规范化/相对解析/受限解析。相对解析样例取自 RFC 3986 5.4.1 与 5.4.2。",
  "resolution_base": "http://a/b/c/d;p?q",
  "parse_cases": [
    {"input": "http://user:pass@Example.COM:8080/a/b/../c?x=1#F",
     "expected": {"scheme": "http", "userinfo": "user:pass", "host": "Example.COM", "port": 8080, "path": "/a/b/../c", "query": "x=1", "fragment": "F", "has_authority": true}},
    {"input": "",
     "expected": {"scheme": null, "userinfo": null, "host": null, "port": null, "path": "", "query": null, "fragment": null, "has_authority": false}},
    {"input": "#frag",
     "expected": {"scheme": null, "userinfo": null, "host": null, "port": null, "path": "", "query": null, "fragment": "frag", "has_authority": false}},
    {"input": "?q=1",
     "expected": {"scheme": null, "userinfo": null, "host": null, "port": null, "path": "", "query": "q=1", "fragment": null, "has_authority": false}},
    {"input": "//host/path",
     "expected": {"scheme": null, "userinfo": null, "host": "host", "port": null, "path": "/path", "query": null, "fragment": null, "has_authority": true}},
    {"input": "http://[2001:db8::1]:8080/p",
     "expected": {"scheme": "http", "userinfo": null, "host": "2001:db8::1", "port": 8080, "path": "/p", "query": null, "fragment": null, "has_authority": true}},
    {"input": "http://[vF.abc]/",
     "expected": {"scheme": "http", "userinfo": null, "host": "vF.abc", "port": null, "path": "/", "query": null, "fragment": null, "has_authority": true}},
    {"input": "mailto:user@example.com",
     "expected": {"scheme": "mailto", "userinfo": null, "host": null, "port": null, "path": "user@example.com", "query": null, "fragment": null, "has_authority": false}},
    {"input": "http://host:80/",
     "expected": {"scheme": "http", "userinfo": null, "host": "host", "port": 80, "path": "/", "query": null, "fragment": null, "has_authority": true}},
    {"input": "http://host/",
     "expected": {"scheme": "http", "userinfo": null, "host": "host", "port": null, "path": "/", "query": null, "fragment": null, "has_authority": true}},
    {"input": "file:///etc/passwd",
     "expected": {"scheme": "file", "userinfo": null, "host": "", "port": null, "path": "/etc/passwd", "query": null, "fragment": null, "has_authority": true}},
    {"input": "http://a/%zz", "error": "invalid percent-encoding", "position": 9},
    {"input": "http://a/%2", "error": "invalid percent-encoding", "position": 9},
    {"input": "http://a b/", "error": "illegal control/whitespace character", "position": 8},
    {"input": "http://[2001:db8::1", "error": "unterminated '['"},
    {"input": "http://a:99999/", "error": "port out of range"},
    {"input": "http://a:xx/", "error": "port must be digits"},
    {"input": "http://2001:db8::1/", "error": "IPv6 literal must be enclosed"}
  ],
  "normalize_cases": [
    {"input": "HTTP://Example.COM:80/a/./b/../c/%2f%ab", "expected": "http://example.com/a/c/%2F%AB"},
    {"input": "http://a/../../g", "expected": "http://a/g"},
    {"input": "HTTPS://ExAmple.com:443/", "expected": "https://example.com/"},
    {"input": "http://[2001:0DB8:0000:0000:0000:0000:0000:0001]/p", "expected": "http://[2001:db8::1]/p"},
    {"input": "http://a/b/c/%7euser?Q=%2f#%Ab", "expected": "http://a/b/c/%7Euser?Q=%2F#%AB"},
    {"input": "http://a:8080/", "expected": "http://a:8080/"},
    {"input": "//EXAMPLE.com/./a", "expected": "//example.com/a"}
  ],
  "resolution_cases": [
    {"ref": "g:h", "expected": "g:h"},
    {"ref": "g", "expected": "http://a/b/c/g"},
    {"ref": "./g", "expected": "http://a/b/c/g"},
    {"ref": "g/", "expected": "http://a/b/c/g/"},
    {"ref": "/g", "expected": "http://a/g"},
    {"ref": "//g", "expected": "http://g/", "accept": ["http://g"], "note": "RFC 样例写作 http://g/；本实现保留空路径，二者对 http 语义等价"},
    {"ref": "?y", "expected": "http://a/b/c/d;p?y"},
    {"ref": "g?y", "expected": "http://a/b/c/g?y"},
    {"ref": "#s", "expected": "http://a/b/c/d;p?q#s"},
    {"ref": "g#s", "expected": "http://a/b/c/g#s"},
    {"ref": "g?y#s", "expected": "http://a/b/c/g?y#s"},
    {"ref": ";x", "expected": "http://a/b/c/;x"},
    {"ref": "g;x", "expected": "http://a/b/c/g;x"},
    {"ref": "g;x?y#s", "expected": "http://a/b/c/g;x?y#s"},
    {"ref": "", "expected": "http://a/b/c/d;p?q"},
    {"ref": ".", "expected": "http://a/b/c/"},
    {"ref": "./", "expected": "http://a/b/c/"},
    {"ref": "..", "expected": "http://a/b/"},
    {"ref": "../", "expected": "http://a/b/"},
    {"ref": "../g", "expected": "http://a/b/g"},
    {"ref": "../..", "expected": "http://a/"},
    {"ref": "../../", "expected": "http://a/"},
    {"ref": "../../g", "expected": "http://a/g"},
    {"ref": "../../../g", "expected": "http://a/g"},
    {"ref": "../../../../g", "expected": "http://a/g"},
    {"ref": "/./g", "expected": "http://a/g"},
    {"ref": "/../g", "expected": "http://a/g"},
    {"ref": "g.", "expected": "http://a/b/c/g."},
    {"ref": ".g", "expected": "http://a/b/c/.g"},
    {"ref": "g..", "expected": "http://a/b/c/g.."},
    {"ref": "..g", "expected": "http://a/b/c/..g"},
    {"ref": "./../g", "expected": "http://a/b/g"},
    {"ref": "./g/.", "expected": "http://a/b/c/g/"},
    {"ref": "g/./h", "expected": "http://a/b/c/g/h"},
    {"ref": "g/../h", "expected": "http://a/b/c/h"},
    {"ref": "g;x=1/./y", "expected": "http://a/b/c/g;x=1/y"},
    {"ref": "g;x=1/../y", "expected": "http://a/b/c/y"},
    {"ref": "http:g", "expected": "http:g"},
    {"ref": "http://a/b/c/%2e%2e/g", "expected": "http://a/b/c/%2e%2e/g"}
  ],
  "safe_resolve_cases": [
    {"base": "http://a/b/c/d", "ref": "g", "expected": "http://a/b/c/g"},
    {"base": "http://a/b/c/d", "ref": "x/../g", "expected": "http://a/b/c/g"},
    {"base": "http://a/b/c/d", "ref": "../g", "error": "escapes base directory"},
    {"base": "http://a/b/c/d", "ref": "/b/c/g", "expected": "http://a/b/c/g"},
    {"base": "http://a/b/c/d", "ref": "%2e%2e/g", "expected": "http://a/b/c/%2E%2E/g"},
    {"base": "http://a/b/c/d", "ref": "../../g", "error": "escapes base directory"},
    {"base": "http://a/b/c/d", "ref": "//evil.com/x", "error": "escapes base authority"},
    {"base": "http://a/b/c/d", "ref": "https://a/b/c/g", "error": "cross-scheme"}
  ]
}
